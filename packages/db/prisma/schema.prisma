generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trace {
  id        String   @id // The traceparent ID
  startTime DateTime
  endTime   DateTime?
  spans     Span[]
  createdAt DateTime @default(now())
}

model Span {
  id              String   @id // ${traceId}:${spanId}
  spanId          String
  traceId         String
  parentSpanId    String?
  name            String   // operation_name e.g. chat, mcp_tool_call
  startTime       DateTime
  endTime         DateTime?
  latencyMs       Int?
  genAiSystem     String?  // e.g. openai, pinecone
  inputTokens     Int?
  outputTokens    Int?
  payloadUri      String?  // minio://bucket/abc-123/span-456.json
  status          String?  // e.g. OK, ERROR, UNSET
  
  trace           Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  parent          Span?    @relation("SpanToSpan", fields: [parentSpanId], references: [id])
  children        Span[]   @relation("SpanToSpan")

  @@index([traceId])
}

model HourlyMetrics {
  id              String   @id @default(cuid())
  timestamp       DateTime
  genAiSystem     String
  inputTokens     Int
  outputTokens    Int
  p50LatencyMs    Float
  p90LatencyMs    Float
  p99LatencyMs    Float
  successCount    Int
  errorCount      Int
  
  @@unique([timestamp, genAiSystem])
  @@index([timestamp])
}
